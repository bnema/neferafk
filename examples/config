# NeferAFK configuration: copy to ~/.config/neferafk/config.
# Delays count from the last input. `off` disables an action.
# Changes apply live, except enabling screens off, enabling lock or sleep
# when both were off at startup, or enabling lock.power-actions when it was off
# at startup: those need a daemon restart.

fade.after = 6m
fade.duration = 2s
lock.after = 5m
screens.off-after = 7m
sleep.after = 20m

# Only output that shows the lock prompt (names from `wlr-randr`). Without it,
# every output shows the prompt.
# lock.output = DP-2

# Lock-screen shortcuts without authentication: Ctrl+F1 suspends, holding
# Ctrl+F2 reboots and holding Ctrl+F3 powers off. Turning it on applies from
# the next lock; turning it off stops them at once
# (the Ctrl help still shows until the next lock).
# lock.power-actions = on

# password (PAM service /etc/pam.d/neferafk) or pin.
auth.mode = password
# PIN mode: 6 to 32 digits from `pass show ENTRY` (or auth.pin-source = env
# with auth.pin-env = VARIABLE). Replace auth.mode above with:
# auth.mode = pin
# auth.pin-source = pass
# auth.pin-entry = neferafk/pin
